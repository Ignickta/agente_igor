# ===== Evolution API (WhatsApp) =====
EVOLUTION_API_URL=https://sua-evolution-api.com
EVOLUTION_API_KEY=sua-chave-global-da-evolution
EVOLUTION_INSTANCE=nome-da-instancia

# ===== OpenAI =====
OPENAI_API_KEY=sk-...
# Opcionais (tem padrao): modelo de chat, transcricao e voz (TTS)
# OPENAI_MODEL=gpt-4o
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
# Modelo do ResearchAgent (web_search). Padrao: OPENAI_MODEL ou gpt-4o
# OPENAI_RESEARCH_MODEL=gpt-4o

# ===== Firebase Admin SDK =====
FIREBASE_PROJECT_ID=seu-projeto-firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@seu-projeto.iam.gserviceaccount.com
# A private key deve estar entre aspas e com \n literais (serao convertidos em runtime)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ===== Servidor =====
PORT=3000

# ===== Opcional =====
# Numero do dono (formato Evolution: 5511999999999) para mensagens proativas
OWNER_PHONE=5511999999999
# Timezone para o scheduler (node-cron)
TZ=America/Sao_Paulo
# Hora padrão para lembretes que citam amanhã, mas não informam um horário.
DEFAULT_REMINDER_TIME=09:00
# Token simples para proteger as rotas /admin
ADMIN_TOKEN=troque-este-token
# Numeros autorizados a conversar com o agente (so digitos, separados por virgula).
# O OWNER_PHONE ja entra automaticamente. Se vazio, so o dono e atendido.
ALLOWED_NUMBERS=

# ===== Atendimento de leads no mesmo numero =====
# Contatos fora de OWNER_PHONE + ALLOWED_NUMBERS entram neste fluxo isolado.
# Mantenha false ate preencher o nome e o contexto comercial abaixo.
LEAD_BOT_ENABLED=false
LEAD_BOT_BUSINESS_NAME=Arroz Marrecão e Arroz Predileto
# Use uma unica linha. Inclua produtos/servicos, publico, regiao, horarios e
# regras comerciais que o atendente pode informar. O bot nunca inventa o resto.
LEAD_BOT_BUSINESS_CONTEXT=Leads das marcas Arroz Marrecão e Arroz Predileto. Atendimento apenas para mercados, distribuidoras, atacadistas e empresas de cesta básica. Não vendemos para consumidor pessoa física.
# Regras de conversa, perguntas obrigatorias, criterios de qualificacao e encaminhamento.
LEAD_BOT_INSTRUCTIONS=Converse de forma leve e humana. Comece perguntando a cidade, depois descubra naturalmente o tipo de empresa e o nome da pessoa. Ao concluir, agradeça e diga que o time comercial continuará por ali. Não tire pedido, não feche venda e não confirme preço, estoque, prazo, frete ou condições comerciais.
# LEAD_BOT_MODEL=gpt-5-mini
# LEAD_BOT_HISTORY_LIMIT=12
# LEAD_BOT_MAX_MESSAGES_PER_HOUR=30
# Kill-switch das mensagens proativas (resumo noturno, revisao semanal, relatorios,
# proatividade). Use 'off' para silenciar todas de uma vez. Padrao: on.
# PROACTIVE_NOTIFICATIONS=on
# Carga maxima estimada de trabalho por dia (minutos) antes de avisar sobrecarga. Padrao 480 (8h).
# MAX_DAILY_WORK_MINUTES=480
# Palavras que marcam uma mensagem como urgente (passam mesmo em modo foco).
# URGENT_KEYWORDS=urgente,urgência,emergência,agora,imediato
# Origem permitida para CORS (painel web). Use * para liberar geral, ou a URL do painel.
CORS_ORIGIN=*

# ===== Google Calendar (opcional) =====
# Usa a MESMA service account do Firebase — sem OAuth. Para ativar:
# 1. Habilite a "Google Calendar API" no projeto Google Cloud do seu Firebase.
# 2. No Google Calendar, compartilhe sua agenda com o FIREBASE_CLIENT_EMAIL
#    com a permissao "Fazer alteracoes nos eventos".
# 3. Defina o ID da agenda (normalmente seu e-mail do Google). Vazio = desligado.
# GOOGLE_CALENDAR_ID=seu-email@gmail.com

# ===== Automacoes n8n (opcional) =====
# Workflows que o agente pode disparar: nome=url-do-webhook, separados por ;
# N8N_WEBHOOKS=enviar-planilha=https://seu-n8n/webhook/abc;cobranca=https://seu-n8n/webhook/def
# Token opcional enviado como Authorization: Bearer
# N8N_WEBHOOK_TOKEN=

# ===== Apps conectados (opcional, leitura) =====
# Outros apps seus (CRM, SaaS...) que o agente pode CONSULTAR (somente leitura).
# Cada app e outro projeto Firebase com service account propria.
# CONNECTED_APPS=crm
# APP_CRM_FIREBASE_PROJECT_ID=meu-crm
# APP_CRM_FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@meu-crm.iam.gserviceaccount.com
# APP_CRM_FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# APP_CRM_DESCRIPTION=CRM multi empresas (clientes, funil, propostas)
# APP_CRM_COLLECTIONS=empresas=Empresas cadastradas;clientes=Clientes por empresa;negocios=Funil de vendas
