# ===== Evolution API (WhatsApp) =====
EVOLUTION_API_URL=https://sua-evolution-api.com
EVOLUTION_API_KEY=sua-chave-global-da-evolution
EVOLUTION_INSTANCE=nome-da-instancia

# ===== OpenAI =====
OPENAI_API_KEY=sk-...

# ===== Firebase Admin SDK =====
FIREBASE_PROJECT_ID=seu-projeto-firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@seu-projeto.iam.gserviceaccount.com
# A private key deve estar entre aspas e com \n literais (serao convertidos em runtime)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ===== Servidor =====
PORT=3000

# ===== Opcional =====
# Numero do dono (formato Evolution: 5511999999999) para mensagens proativas
OWNER_PHONE=5511999999999
# Timezone para o scheduler (node-cron)
TZ=America/Sao_Paulo
# Token simples para proteger as rotas /admin
ADMIN_TOKEN=troque-este-token
# Numeros autorizados a conversar com o agente (so digitos, separados por virgula).
# O OWNER_PHONE ja entra automaticamente. Se vazio, so o dono e atendido.
ALLOWED_NUMBERS=
